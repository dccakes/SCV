{
  "name": "oswp",
  "description": "The Open Source Wedding Project - A modern, open-source wedding planning and RSVP management system",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx prisma generate && npx prisma migrate deploy && next build",
    "build:ci": "SKIP_ENV_VALIDATION=true next build",
    "build:analyze": "SKIP_ENV_VALIDATION=true next build --analyze",
    "build:turbo": "NODE_OPTIONS='--trace-uncaught' SKIP_ENV_VALIDATION=true next build --turbopack",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev": "next dev",
    "dev:turbo": "NODE_OPTIONS='--trace-uncaught' next dev --turbopack",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint-staged": "lint-staged",
    "test:unit": "SKIP_ENV_VALIDATION=true jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "start": "next start",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.937.0",
    "@captchafox/react": "^1.11.0",
    "@daveyplate/better-auth-ui": "^3.2.11",
