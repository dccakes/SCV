// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// Core: Wedding is the root entity
model Wedding {
  id                       String        @id @default(uuid())
  organizationId           String?       @unique
  organization             Organization? @relation("WeddingOrganization", fields: [organizationId], references: [id])
  groomFirstName           String
  groomLastName            String
  brideFirstName           String
  brideLastName            String
  enabledAddOns            String[]      @default([]) // e.g., ["website", "tasks", "gifts"]
  selfFillToken            String?       @unique // Unique token for self-fill guest registration link
  selfFillTokenGeneratedAt DateTime? // When the current token was generated (enables expiry)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  // User relationships (many-to-many through UserWedding)
  userWeddings UserWedding[]

  // Core relationships
  events      Event[]
  guests      Guest[]
  households  Household[]
  invitations Invitation[]
  guestTags   GuestTag[]

  // Add-on relationships
  website    Website?
  vendors    Vendor[]
  tasks      Task[]
  milestones Milestone[]

  // Budgeting
  budget           Budget?
  budgetCategories BudgetCategory[]
  budgetExpenses   BudgetExpense[]

  // Etta AI agent
  ettaActor       EttaActor?
  ettaSuggestions EttaSuggestion[]
  ettaMemories    EttaMemory[]
  auditLogs       AuditLog[]
  guestQuestions  GuestQuestion[]
  faqs            Faq[]
  notifications   Notification[]
  householdNotes  HouseholdNote[]
  vendorNotes     VendorNote[]
  vendorCategoryConfigs VendorCategoryConfig[]

  // Messaging (Telegram bot, future: WhatsApp)
  messagingIdentities    MessagingIdentity[]
  messagingPairingTokens MessagingPairingToken[]
  chatMessages           ChatMessage[]

  @@index([selfFillToken, selfFillTokenGeneratedAt])
}

// Join table: Allows multiple users per wedding (co-management)
model UserWedding {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weddingId String
  wedding   Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  // Role for future access control (e.g., "owner", "member", "viewer")
  role String @default("owner")

  // Indicates if this is the primary/creator user
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weddingId])
  @@index([userId])
  @@index([weddingId])
}

// Add-on: Website (guest-facing wedding website)
model Website {
  id                String     @id @default(uuid())
  weddingId         String     @unique
  wedding           Wedding    @relation(fields: [weddingId], references: [id], onDelete: Cascade)
  subUrl            String     @unique
  templateId        String?
  isPasswordEnabled Boolean    @default(false)
  password          String?
  isRsvpEnabled     Boolean    @default(true)
  coverPhotoUrl     String?
  headerImageUrl    String?
  coupleImageUrls   String[]   @default([])
  generalQuestions  Question[] @relation(name: "Website_Questions")
  websiteSections   WebsiteSection[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([weddingId])
}

enum WebsiteSectionType {
  HOME
  OUR_STORY
  TIMELINE
  DESTINATION
  EXPERIENCES
  WEDDING_PARTY
  TRAVEL
  FAQ
  REGISTRY
  SAVE_THE_DATE
  INVITATION
}

model WebsiteSection {
  id        String             @id @default(uuid())
  websiteId String
  website   Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  type      WebsiteSectionType
  isEnabled Boolean            @default(true)
  position  Int
  content   Json
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([websiteId, type])
  @@index([websiteId, position])
}

