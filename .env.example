# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"

# Optional: Direct database connection URL for connection pooling
# Useful for services like Neon, Supabase, or PgBouncer
# DIRECT_URL="postgresql://user:password@localhost:5432/database_name"


# =============================================================================
# BETTER AUTH CONFIGURATION (REQUIRED)
# =============================================================================

# REQUIRED: Secret key for Better Auth session management
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here-use-openssl-rand-base64-32"

# Optional: Base URL for Better Auth (defaults to http://localhost:3000)
# Update this for production deployments
# NEXT_PUBLIC_APP_URL="http://localhost:3000"


# =============================================================================
# AWS S3 STORAGE (OPTIONAL)
# =============================================================================
# Required only if you want to enable cover photo uploads

# AWS_S3_BUCKET_NAME="your-bucket-name"
# AWS_S3_REGION="us-east-1"
# AWS_S3_ACCESS_KEY_ID="your-access-key-id"
# AWS_S3_SECRET_ACCESS_KEY="your-secret-access-key"


# =============================================================================
# VERCEL BLOB STORAGE (OPTIONAL)
# =============================================================================
# Required for vendor quote file uploads
# Auto-provisioned when a Blob store is linked in the Vercel dashboard
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."


# =============================================================================
# OAUTH PROVIDERS (OPTIONAL)
# =============================================================================
# Uncomment and configure to enable social login

# GitHub OAuth
# Get your credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth
# Get your credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"


# =============================================================================
# EMAIL (RESEND) - Required for OTP login, password reset, and email verification
# =============================================================================
# Get your API key from https://resend.com
# RESEND_API_KEY="re_..."
# Must be a verified domain/address in your Resend account
# EMAIL_FROM="noreply@yourdomain.com"


# =============================================================================
# ETTA AI AGENT (OPTIONAL)
# =============================================================================
# Required to enable the Etta AI wedding planning assistant

# Vercel AI Gateway API key (recommended — single key for all providers)
# Get your key from https://vercel.com/dashboard/ai-gateway
# AI_GATEWAY_API_KEY="aigw_..."

# Anthropic API key (alternative to AI Gateway, or for direct Anthropic access)
# Get your API key from https://console.anthropic.com
# ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI API key for embeddings (text-embedding-3-small) — used by Etta memory
# Get your API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-..."

# JWT secret for guest concierge tokens
# Generate with: openssl rand -base64 32
# JWT_SECRET="your-jwt-secret-here"

# Model to use for Etta (Vercel AI Gateway format: provider/model)
# Defaults to anthropic/claude-haiku-4.5
# Examples: "openai/gpt-4o", "anthropic/claude-sonnet-4.5", "google/gemini-2.5-flash"
# Full list: https://sdk.vercel.ai/docs/ai-sdk-providers/ai-gateway
# ETTA_MODEL="anthropic/claude-haiku-4.5"

# Twilio WhatsApp (guest concierge channel)
# Each wedding claims a dedicated WhatsApp sender number from the
# whatsapp_numbers pool (provision rows there with your Twilio numbers, E.164).
# Point each number's incoming-message webhook at /api/webhooks/whatsapp.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# Public URL Twilio signs requests against (only needed behind proxies)
# WHATSAPP_WEBHOOK_URL="https://yourapp.com/api/webhooks/whatsapp"
# Debounce before Etta answers a burst of guest messages (default 4000)
# WHATSAPP_DEBOUNCE_MS="4000"


# =============================================================================
# ANALYTICS (POSTHOG) - OPTIONAL
# =============================================================================
# Product + template analytics. When these are unset, analytics is a no-op
# (nothing is captured) so the app runs fine without PostHog configured.
# Get your project API key from https://us.posthog.com (Project Settings).
#
# The client SDK initializes in `instrumentation-client.ts` and talks to
# PostHog through the `/oswp-pHsc1` reverse proxy (see the rewrites in
# next.config.js) so requests aren't blocked by ad-blockers.

# Client-side project token (exposed to the browser — a public "phc_..." key).
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_..."
# PostHog app/UI host, used for the toolbar and links back to PostHog.
# NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"

# Optional dedicated server-side key. Falls back to
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN (same project) when omitted.
# POSTHOG_KEY="phc_..."
# POSTHOG_HOST="https://us.i.posthog.com"


# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Node environment
NODE_ENV="development"

# Optional: Skip environment variable validation during build
# Useful for CI/CD pipelines
# SKIP_ENV_VALIDATION="true"
