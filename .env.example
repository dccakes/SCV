# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"

# Optional: Direct database connection URL for connection pooling
# Useful for services like Neon, Supabase, or PgBouncer
# DIRECT_URL="postgresql://user:password@localhost:5432/database_name"


# =============================================================================
# BETTER AUTH CONFIGURATION (REQUIRED)
# =============================================================================

# REQUIRED: Secret key for Better Auth session management
# Generate a secure secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here-use-openssl-rand-base64-32"

# Optional: Base URL for Better Auth (defaults to http://localhost:3000)
# Update this for production deployments
# NEXT_PUBLIC_APP_URL="http://localhost:3000"


# =============================================================================
# AWS S3 STORAGE (OPTIONAL)
# =============================================================================
# Required only if you want to enable cover photo uploads

# AWS_S3_BUCKET_NAME="your-bucket-name"
# AWS_S3_REGION="us-east-1"
# AWS_S3_ACCESS_KEY_ID="your-access-key-id"
# AWS_S3_SECRET_ACCESS_KEY="your-secret-access-key"


# =============================================================================
# VERCEL BLOB STORAGE (OPTIONAL)
# =============================================================================
# Required for vendor quote file uploads
# Auto-provisioned when a Blob store is linked in the Vercel dashboard
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."


# =============================================================================
# OAUTH PROVIDERS (OPTIONAL)
# =============================================================================
# Uncomment and configure to enable social login

# GitHub OAuth
# Get your credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# Google OAuth
# Get your credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"


# =============================================================================
# GMAIL INTEGRATION (OPTIONAL)
# =============================================================================
# Required for the Gmail Connections feature (read vendor emails, create drafts)
# Uses the same Google OAuth credentials as above (GOOGLE_CLIENT_ID/SECRET)
# Ensure the Gmail API is enabled in your Google Cloud Console
# Add {APP_URL}/api/gmail/callback as an authorized redirect URI
# Required scopes: gmail.readonly, gmail.compose, userinfo.email


# =============================================================================
# EMAIL (RESEND) - Required for OTP login, password reset, and email verification
# =============================================================================
# Get your API key from https://resend.com
# RESEND_API_KEY="re_..."
# Must be a verified domain/address in your Resend account
# EMAIL_FROM="noreply@yourdomain.com"


# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Node environment
NODE_ENV="development"

# Optional: Skip environment variable validation during build
# Useful for CI/CD pipelines
# SKIP_ENV_VALIDATION="true"
